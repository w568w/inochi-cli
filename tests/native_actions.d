module tests.native_actions;
import cli.context;
import creator.actions;
import creator.core.actionstack;
import creator.panels.parameters : convertTo2D;
import creator.ext;
import inochi2d;
import std.stdio;
import std.exception;

int main(string[] args) {
    initGL(); scope(exit) closeGL(); incActionInit();
    auto context = new Context(args.length > 1 ? args[1] : "tests/results/fixture.inx");
    auto puppet = context.puppet;
    auto source = parameter(puppet, "Blink");
    auto driver = cast(SimplePhysics)node(puppet, "Pendulum");
    driver.param(source); puppet.rescanNodes();
    auto sine = new ExSineAutomation(puppet);
    AutomationBinding binding; binding.param = source; binding.paramId = source.name; binding.range = vec2(0, 1);
    sine.bind(binding); puppet.automation ~= sine;
    Animation animation; animation.length = 10; animation.timestep = 1f / 60;
    AnimationLane lane; lane.paramRef = new AnimationParameterRef(source, 0); animation.lanes ~= lane;
    puppet.getAnimations()["Linked"] = animation;
    convertTo2D(source);
    auto replacement = parameter(puppet, "Blink");
    enforce(replacement !is source && replacement.isVec2 && driver.param is replacement);
    enforce(sine.projectBindings[0].param is replacement && puppet.getAnimations()["Linked"].lanes[0].paramRef.targetParam is replacement);
    incActionUndo(); enforce(parameter(puppet, "Blink") is source && driver.param is source);
    enforce(sine.projectBindings[0].param is source && puppet.getAnimations()["Linked"].lanes[0].paramRef.targetParam is source);
    incActionRedo(); enforce(parameter(puppet, "Blink") is replacement && driver.param is replacement);
    auto removal = new ParameterRemoveAction(replacement, &puppet.parameters);
    incActionPush(removal); puppet.removeParameter(replacement);
    enforce(sine.projectBindings.length == 0 && puppet.getAnimations()["Linked"].lanes.length == 0 && driver.param is null);
    incActionUndo(); enforce(parameter(puppet, "Blink") is replacement && driver.param is replacement);
    enforce(replacement in puppet.getParameterDrivers());
    enforce(sine.projectBindings.length == 1 && puppet.getAnimations()["Linked"].lanes.length == 1);
    incActionRedo(); enforce(sine.projectBindings.length == 0 && puppet.getAnimations()["Linked"].lanes.length == 0);
    writeln("PASS native Creator conversion and parameter deletion undo/redo preserve graph references");
    auto part = node(puppet, "Part");
    auto xy = parameter(puppet, "XY"); xy.getOrAddBinding(part, "transform.t.x");
    auto before = context.snapshot();
    incDeleteChildWithHistory(part);
    enforce(xy.bindings.length == 0);
    incActionUndo(); enforce(xy.bindings.length == 1 && part.parent !is null);
    enforce(context.snapshot().model == before.model);
    incActionRedo(); enforce(xy.bindings.length == 0 && part.parent is null);
    writeln("PASS native Creator bound node deletion undo/redo restores the original model bytes");
    return 0;
}
