diff --git a/source/creator/ext/automation.d b/source/creator/ext/automation.d
new file mode 100644
--- /dev/null
+++ b/source/creator/ext/automation.d
@@ -0,0 +1,49 @@
+module creator.ext.automation;
+import inochi2d;
+import inochi2d.core.automation.sine;
+import inochi2d.core.automation.phys;
+
+// These fields are editable runtime state; retain them in Creator projects too.
+mixin template AutomationProjectFields() {
+    override void serializeSelf(ref InochiSerializer serializer) {
+        super.serializeSelf(serializer);
+        if (!enabled) { serializer.putKey("enabled"); serializer.putValue(enabled); }
+        static if (is(typeof(this.phase))) {
+            if (phase != 0) { serializer.putKey("phase"); serializer.putValue(phase); }
+        }
+    }
+    override void deserializeSelf(Fghj data) {
+        static if (is(typeof(this.phase))) {
+            if (!data["speed"].isEmpty) data["speed"].deserializeValue(speed);
+            int kind;
+            auto error=data["sine_type"].deserializeValue(kind);
+            if (!error) {
+                import std.exception : enforce;
+                enforce(kind>=0 && kind<=2,"Invalid sine type");sineType=cast(typeof(sineType))kind;
+            } else data["sine_type"].deserializeValue(sineType);
+        } else super.deserializeSelf(data);
+        if (!data["enabled"].isEmpty) data["enabled"].deserializeValue(enabled);
+        static if (is(typeof(this.phase))) {
+            if (!data["phase"].isEmpty) data["phase"].deserializeValue(phase);
+        }
+        // The 0.8.6 SDK reads AutomationBinding.range from the axis field.
+        size_t index;
+        foreach (row; data["bindings"].byElement) {
+            if (index < bindings.length) bindings[index].range.deserialize(row["range"]);
+            index++;
+        }
+    }
+    ref AutomationBinding[] projectBindings() { return bindings; }
+}
+@TypeId("sine") class ExSineAutomation : SineAutomation {
+    this(Puppet parent) { super(parent); }
+    mixin AutomationProjectFields;
+}
+@TypeId("physics") class ExPhysicsAutomation : PhysicsAutomation {
+    this(Puppet parent) { super(parent); }
+    mixin AutomationProjectFields;
+}
+void incRegisterExAutomation() {
+    inRegisterAutomationType!ExSineAutomation();
+    inRegisterAutomationType!ExPhysicsAutomation();
+}
